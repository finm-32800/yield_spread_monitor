# Copy this file to .env and paste your FRED API key after the equals sign.
# Get a key (free, instant) at https://fredaccount.stlouisfed.org/apikeys
# .env is gitignored: the key never goes into a commit.
FRED_API_KEY=

# The data window (START_DATE, END_DATE) is not a setting: it is committed in
# src/settings.py, so that every build of a commit pulls the same thing.
